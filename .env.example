# Copy to .env and fill in real values locally. On Render, set these in the
# service's Environment tab instead — this file is never read in production.

DATABASE_URL="postgresql://username:password@host/database?sslmode=require"
JWT_SECRET="generate_a_long_random_string_here"
PORT=4000
OPENAI_API_KEY="your_openai_api_key_here"

# Must be explicitly set to "production" on Render — several security-relevant
# code paths (see environment-audit.md §3) key off this value and are unsafe
# if it's left unset.
NODE_ENV=production

# PHP Gateway (must exactly match INTERNAL_API_KEY in php_bdapps_gateway/.env)
PHP_GATEWAY_URL="https://bdappsdigitalapps.com/api"
INTERNAL_API_KEY="generate_a_64_char_random_hex_string_here"
