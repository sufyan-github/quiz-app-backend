datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum QuestionType {
  MCQ
  MULTIPLE_SELECT
  TRUE_FALSE
  FILL_BLANK
  SHORT_ANSWER
  LONG_ANSWER
  NUMERICAL
  CODING
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model User {
  id                  String  @id @default(uuid())
  email               String  @unique
  password            String?
  mobile              String? @unique
  subscription_status String  @default("UNSUBSCRIBED")
  coins               Int     @default(0)
  xp                  Int     @default(0)
  level               Int     @default(1)
  streak              Int     @default(0)
  freeExamsUsed       Int     @default(0)
  freeAiGenerationsUsed Int   @default(0)
  lastLoginDate       DateTime?

  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions  Subscription[]
  profile        Profile?
  settings       UserSettings?
  activityLogs   ActivityLog[]
  deviceSessions DeviceSession[]
  bookmarks      Bookmark[]
  achievements   UserAchievement[]

  examsCreated      Exam[]           @relation("ExamCreator")
  attempts          ExamAttempt[]
  certificates      Certificate[]
  notifications     Notification[]
  aiConversations   AiConversation[]
  aiFeedbacks       AiFeedback[]
  userSubscriptions UserSubscription[]
  transactions      Transaction[]
  paidExams         PaidExamAccess[]
  guardianLink      GuardianLink?
  examHistories     ExamHistory[]
  dailyLoginRewards DailyLoginReward[]
}


model Profile {
  id         String    @id @default(uuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id])
  name       String
  username   String?   @unique
  employeeId String?
  rollNumber String?
  regNumber  String?
  gender     String?
  dob        DateTime?
  bloodGroup String?

  photo      String?
  coverPhoto String?

  phone       String?
  altPhone    String?
  address     String?
  city        String?
  state       String?
  district    String?
  postalCode  String?
  country     String?
  nationality String?

  // Academic / Student Info
  institution  String?
  department   String?
  program      String?
  semester     String?
  batch        String?
  session      String?
  academicYear String?

  // Professional / Admin Info
  designation   String?
  employeeType  String?
  joiningDate   DateTime?
  experience    String?
  skills        String?
  qualification String?
  orgName       String?
  orgLogo       String?
  orgWebsite    String?

  // Bio & Social
  shortBio   String?
  aboutMe    String?
  interests  String?
  careerGoal String?

  linkedin  String?
  github    String?
  portfolio String?
  facebook  String?
  twitter   String?
}

model Category {
  id          String    @id @default(uuid())
  name        String
  description String?
  subjects    Subject[]
}

model Subject {
  id         String     @id @default(uuid())
  name       String
  categoryId String
  category   Category   @relation(fields: [categoryId], references: [id])
  topics     Topic[]
  exams      Exam[]
  questions  Question[]
}

model Topic {
  id                   String                @id @default(uuid())
  name                 String
  subjectId            String
  subject              Subject               @relation(fields: [subjectId], references: [id])
  questions            Question[]
  exams                Exam[]
  lessons              Lesson[]
  aiGeneratedQuestions AiGeneratedQuestion[]
}

model Question {
  id            String       @id @default(uuid())
  text          String
  type          QuestionType
  difficulty    Difficulty
  marks         Float        @default(1.0)
  negativeMarks Float        @default(0.0)
  language      String       @default("english")
  explanation   String?
  hint          String?

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])
  topicId   String?
  topic     Topic?   @relation(fields: [topicId], references: [id])

  options        Option[]
  examQuestions  ExamQuestion[]
  studentAnswers StudentAnswer[]
}

model Option {
  id         String   @id @default(uuid())
  text       String
  isCorrect  Boolean  @default(false)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
}

model Exam {
  id           String  @id @default(uuid())
  title        String
  description  String?
  instructions String?

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])
  topicId   String?
  topic     Topic?   @relation(fields: [topicId], references: [id])

  creatorId String
  creator   User   @relation("ExamCreator", fields: [creatorId], references: [id])

  startDate    DateTime?
  endDate      DateTime?
  durationMins Int? // Overall timer
  passingMarks Float     @default(40.0)
  maxAttempts  Int? // Null means unlimited

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions ExamQuestion[]
  attempts  ExamAttempt[]
}

model ExamQuestion {
  id         String   @id @default(uuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id])
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  order      Int      @default(0)
}

model ExamAttempt {
  id        String @id @default(uuid())
  examId    String
  exam      Exam   @relation(fields: [examId], references: [id])
  studentId String
  student   User   @relation(fields: [studentId], references: [id])

  startTime DateTime  @default(now())
  endTime   DateTime?
  status    String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, ABANDONED

  score    Float?
  isPassed Boolean?

  answers StudentAnswer[]
  result  Result?
}

model StudentAnswer {
  id         String      @id @default(uuid())
  attemptId  String
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id])
  questionId String
  question   Question    @relation(fields: [questionId], references: [id])

  selectedOptionId String? // For MCQ
  textAnswer       String? // For fill in blanks / short answer
  isCorrect        Boolean?
  marksAwarded     Float?
}

model Result {
  id            String      @id @default(uuid())
  attemptId     String      @unique
  attempt       ExamAttempt @relation(fields: [attemptId], references: [id])
  totalScore    Float
  correctCount  Int
  wrongCount    Int
  skippedCount  Int
  negativeMarks Float
  timeTakenSecs Int
  accuracy      Float
  grade         String?

  certificate Certificate?
}

model Certificate {
  id             String   @id @default(uuid())
  resultId       String   @unique
  result         Result   @relation(fields: [resultId], references: [id])
  studentId      String
  student        User     @relation(fields: [studentId], references: [id])
  certificateUrl String
  issuedAt       DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model UserSettings {
  id       String @id @default(uuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])
  theme    String @default("light") // light, dark, system
  language String @default("en")
  timezone String @default("UTC")

  // Notification Prefs
  emailNotif Boolean @default(true)
  smsNotif   Boolean @default(false)
  pushNotif  Boolean @default(true)

  // 2FA
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  module    String?
  ipAddress String?
  device    String?
  browser   String?
  os        String?
  createdAt DateTime @default(now())
}

model DeviceSession {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  deviceId   String?
  deviceName String?
  ipAddress  String?
  location   String?
  lastActive DateTime @default(now())
  isCurrent  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Bookmark {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  itemType String // QUESTION, EXAM, SUBJECT
  itemId   String

  createdAt DateTime @default(now())

  @@unique([userId, itemType, itemId])
}

model Achievement {
  id          String            @id @default(uuid())
  name        String
  description String?
  icon        String?
  points      Int               @default(0)
  users       UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  earnedAt      DateTime    @default(now())

  @@unique([userId, achievementId])
}

// The single real source of truth for a user's BDApps telco (Robi/Airtel)
// direct-carrier-billing subscription state. Written only by
// bdappsController.verifyOtp (initial subscribe) and the BDApps webhook
// handler (subscriptionController.handleWebhook) - never by the client.
model Subscription {
  id            String    @id @default(uuid())
  subscriber_id String
  user          User      @relation(fields: [subscriber_id], references: [id])
  status        String    @default("REGISTERED") // REGISTERED, UNSUBSCRIBED
  operator      String? // ROBI, AIRTEL - unknown for older rows
  referenceNo   String? // BDApps-issued reference from otp/verify or getStatus
  frequency     String?
  lastCheckedAt DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@index([subscriber_id])
  @@index([status])
}

// Durable audit trail of every inbound BDApps webhook delivery. Exists to
// make replay/duplicate-delivery detection possible (idempotencyKey is
// unique) and to give the admin dashboard a real "Webhook Logs" table -
// previously this only existed as PHP-side text-file logging, invisible
// to the Node backend and the admin dashboard entirely.
model WebhookLog {
  id              String   @id @default(uuid())
  source          String   @default("BDAPPS")
  subscriberId    String?
  mobile          String?
  rawPayload      Json
  receivedStatus  String?
  signatureValid  Boolean  @default(false)
  processed       Boolean  @default(false)
  processingNote  String?
  idempotencyKey  String   @unique
  createdAt       DateTime @default(now())

  @@index([mobile])
  @@index([createdAt])
}

model SmsLog {
  id        String   @id @default(uuid())
  mobile    String
  message   String
  status    String
  createdAt DateTime @default(now())
}

model UssdLog {
  id        String   @id @default(uuid())
  session   String
  request   String
  response  String
  createdAt DateTime @default(now())
}

// ==========================================
// LEARNING MODULE
// ==========================================

model Lesson {
  id        String   @id @default(uuid())
  title     String
  content   String? // Markdown content
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id])
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resources LessonResource[]
}

model LessonResource {
  id        String   @id @default(uuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  type      String // PDF, VIDEO, IMAGE, LINK
  url       String
  title     String?
  createdAt DateTime @default(now())
}

// ==========================================
// AI INTEGRATION
// ==========================================

model AiConversation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  topic     String?
  context   String? // Question ID or Lesson ID context
  messages  Json // Array of { role: 'user'|'assistant', content: string }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiFeedback {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  targetType String // QUESTION, LESSON, EXAM
  targetId   String
  feedback   String // The AI generated hint/explanation
  createdAt  DateTime @default(now())
}

model AiGeneratedQuestion {
  id          String   @id @default(uuid())
  topicId     String
  topic       Topic    @relation(fields: [topicId], references: [id])
  generatedBy String // Admin User ID
  content     Json // The generated question payload
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt   DateTime @default(now())
}

model AiPromptTemplate {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?
  systemPrompt String
  userPrompt   String?
  model        String   @default("gpt-4o")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SubscriptionPlan {
  id             String   @id @default(uuid())
  name           String
  price          Float
  durationMonths Int
  active         Boolean  @default(true)
  features       String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userSubscriptions UserSubscription[]
}

model UserSubscription {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  planId         String
  plan           SubscriptionPlan @relation(fields: [planId], references: [id])
  startDate      DateTime         @default(now())
  endDate        DateTime
  status         String           @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([userId])
  @@index([status])
}

// Doubles as the subscription transaction ledger: every real
// subscription-state-change event (BDApps otp/verify, BDApps webhook,
// or a completed generic checkout) writes one row here. provider='BDAPPS'
// rows are the real Robi/Airtel subscription events; other providers are
// the separate, not-yet-integrated generic checkout path in
// paymentController.ts (unchanged by this work).
model Transaction {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  amount        Float
  currency      String   @default("BDT")
  status        String   @default("PENDING") // SUCCESS, PENDING, FAILED
  provider      String // BDAPPS, bKash, Nagad, SSLCommerz, Stripe, etc.
  transactionId String   @unique
  purpose       String // SUBSCRIPTION, PAY_PER_EXAM
  planId        String?
  examId        String?
  couponCode    String? // set when a Coupon was applied at checkout - enables real coupon-usage reporting
  receiptUrl    String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([provider])
  @@index([couponCode])
}

model PaidExamAccess {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  examId    String
  createdAt DateTime @default(now())

  @@unique([userId, examId])
}

model Coupon {
  id            String   @id @default(uuid())
  code          String   @unique
  discountType  String // PERCENTAGE, FIXED
  discountValue Float
  expiryDate    DateTime
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model SmsGatewayConfig {
  id        String   @id @default(uuid())
  provider  String   @default("BDAPPS") // BDAPPS, MOCK, TWILIO
  costPerSms Float   @default(0.3)
  senderId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GuardianLink {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  guardianMobile String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
}

// ==========================================
// EXAM HISTORY & REPORTS
// ==========================================

model ExamHistory {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  topicId         String?
  subjectId       String?
  categoryName    String?
  topicName       String?
  totalQuestions  Int
  correctAnswers  Int
  wrongAnswers    Int
  skippedAnswers  Int
  score           Float
  totalMarks      Float
  percentage      Float
  timeTakenSecs   Int
  accuracy        Float
  xpEarned        Int      @default(0)
  coinsEarned     Int      @default(0)
  negativeMarking Boolean  @default(false)
  negativeValue   Float    @default(0.25)
  difficulty      String?
  language        String   @default("english")
  aiFeedback      String?
  weakAreas       String[] // topic names
  strongAreas     String[] // topic names
  topicBreakdown  Json     @default("{}")
  isPremium       Boolean  @default(false)
  createdAt       DateTime @default(now())
}

// ==========================================
// AUTO QUIZ CONFIGURATION
// ==========================================

// ==========================================
// LANDING PAGE REAL TRIAL - one per IP, ever
// ==========================================

// Persisted (not in-memory) so the one-time cap survives Render restarts
// and works correctly if the backend is ever scaled to multiple instances.
model TrialIpUsage {
  id        String   @id @default(uuid())
  ip        String   @unique
  createdAt DateTime @default(now())
}

model SubjectQuizConfig {
  id              String   @id @default(uuid())
  subjectName     String   @unique // "Mathematics", "Physics", etc.
  defaultQuestions Int     @default(20)
  defaultTimeMins  Int     @default(30)
  defaultPassingPct Float  @default(40.0)
  marksPerQuestion Float   @default(1.0)
  negativeMarksDefault Float @default(0.25)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==========================================
// LEADERBOARD SNAPSHOTS
// ==========================================

model LeaderboardSnapshot {
  id        String   @id @default(uuid())
  userId    String
  mobile    String
  xp        Int
  level     Int
  period    String   // DAILY, WEEKLY, MONTHLY, ALL_TIME
  subjectId String?
  rank      Int?
  createdAt DateTime @default(now())
}

// ==========================================
// DAILY LOGIN REWARDS
// ==========================================

model DailyLoginReward {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  coinsGranted Int     @default(10)
  xpGranted   Int      @default(5)
  streakDay   Int      @default(1)
  createdAt   DateTime @default(now())

  @@unique([userId, createdAt])
}
